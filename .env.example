# ==============================================================================
# CONFIGURAÇÕES DE AMBIENTE - EXEMPLO
# Copie este arquivo para '.env' e insira suas credenciais reais.
# NUNCA envie o arquivo '.env' com chaves reais para o GitHub.
# ==============================================================================

# Alpha Vantage API Key (Obtenha gratuitamente em: https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=SUA_CHAVE_AQUI

# Catálogo do Databricks Unity Catalog (padrão em Community/Free: 'workspace')
DATABRICKS_CATALOG=workspace

# Modo de Execução: 'LOCAL' (usa pastas locais) ou 'DATABRICKS' (usa Unity Catalog)
EXECUTION_ENV=LOCAL

# Diretório base para armazenamento Delta local
LOCAL_STORAGE_PATH=./data
